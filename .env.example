# Narnix AI assistant backend configuration.
# Copy to `.env` and fill in real values — `docker compose` reads it, and so
# does `uv run fastapi dev` (via pydantic-settings).


# --- LLM provider ---
# Select which provider the application uses.
# Supported values depend on the provider initialization in the application.
CHAT_MODEL_PROVIDER=openai


# --- OpenAI-compatible provider / AgentRouter ---
# AgentRouter exposes an OpenAI-compatible API.
# Get your API key from your AgentRouter account.
OPENAI_API_KEY=replace-me

# Model name as accepted by AgentRouter.
OPENAI_MODEL=gpt-5.6-sol

# Maximum number of output tokens requested from the model.
OPENAI_MAX_TOKENS=16384

# OpenAI-compatible API base URL.
OPENAI_BASE_URL=https://agentrouter.org/v1


# --- OpenRouter (the LLM provider) ---
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me
# Any model OpenRouter serves, as provider/model. Change freely — nothing else
# in the codebase cares.
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MAX_TOKENS=16384

# --- Worker integration ---
# HMAC-SHA256 key shared with the Cloudflare Worker. It signs messages in both
# directions (worker → backend, backend → worker's /ai/callback) with a
# timestamp header to defeat replays. Must be identical on both sides; rotate
# together. Generate one with: openssl rand -hex 32
AI_CALLBACK_SECRET=replace-with-a-long-random-hex-string
# The worker endpoint that receives this backend's callbacks.
WORKER_CALLBACK_URL=https://your-worker.workers.dev/ai/callback

# --- Infrastructure (compose defaults shown) ---
DATABASE_URL=postgresql://narnix:narnix@postgres:5432/narnix_ai
REDIS_URL=redis://redis:6379/0

# --- Behaviour ---
# Per-user inbound message rate limit.
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=300

# --- Web tools (optional) ---
# Local SearXNG instance for the search/fetch tools. Empty = tools report
# "unavailable" (the agent still answers from FAQ + live data). See docker-compose.
SEARXNG_URL=http://searxng:8080
FETCH_ALLOWED_DOMAINS=narnix.com,docs.narnix.com,github.com,hiddify.com,v2box.com
# FETCH_ALLOWED_DOMAINS overrides the list above when set (comma-separated).
# Leave empty to use the built-in defaults.
